# highlights.live — docker-compose deployment env template
# ============================================================
# Copy to `.env` (repo root, next to this file) and fill in real values, then:
#   git pull origin master
#   docker compose -f docker/docker-compose.yml up -d --force-recreate orchestrator media
#
# Docker Compose auto-loads `.env` from the project directory and substitutes the
# ${VAR:-default} references in docker/docker-compose.yml. NEVER commit a real
# `.env` (it holds secrets). This file is the durable documentation of every
# variable the compose stack reads — especially the live-payment set below,
# which is required for the paid path to work after a redeploy.

# ---------------------------------------------------------------------------
# LIVE-PAYMENT (root cause of recurring 402) — REQUIRED on the paid stack
# ---------------------------------------------------------------------------
# These MUST be present (non-empty) in .env, otherwise a redeploy resolves the
# ${SIGNER_URL:-} / ${PAYER_ADDRESS:-} placeholders to empty and every paid
# live/VOD session fails with 402 "invalid live runner payment signer address".
# See http://127.0.0.1:3000/- docs/DEPLOY.md "Live-payment durability".
#
# The remote signer's internal address (docker network DNS). The server and the
# media caller both send + validate live payments through this signer.
SIGNER_URL=http://signer:7936
# The payer EVM address advertised on reserve (public on-chain address).
PAYER_ADDRESS=
# Shared bearer token the server sends to the remote signer
# (Authorization: Bearer <token> via -remoteSignerHeaders). SECRET — keep in .env.
SIGNER_AUTH_TOKEN=
# Orchestrator ticket EV. docker-compose.yml now hard-codes -ticketEV=80000000000
# (see ADAAAA-3932) so the ORCHESTRATOR sizes live lottery batches <100 regardless;
# keep this at 80000000000 here for the signer side / documentation consistency.
TICKET_EV=80000000000

# ---------------------------------------------------------------------------
# ORCHESTRATOR (go-livepeer)
# ---------------------------------------------------------------------------
ORCHESTRATOR_SECRET=change-me
ARBITRUM_RPC=
ORCHESTRATOR_ETH_PASSWORD=change-me
PRICE_PER_UNIT=1

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=https://highlights-server.dpn.gg
PUBLIC_BASE_URL=https://highlights-server.dpn.gg
POSTGRES_USER=highlights
POSTGRES_PASSWORD=change-me
POSTGRES_DB=highlights
DECIDE_FEE=0.01
DECIDE_MODE=
MAX_PRICE_PER_UNIT=
FREE_DECIDES=5
FREE_HIGHLIGHTS=3
MEDIA_SERVER_URL=http://media:4070
MEDIA_PUBLIC_BASE_URL=https://highlights-media.dpn.gg
MEDIA_PROVISION_NO_CLIENT_MS=60000
EMAIL_SENDER_URL=http://email:3001
MAILER_TOKEN=change-me
EMAIL_ALLOCATOR_BATCH_SIZE=
EMAIL_ALLOCATOR_INTERVAL_MS=
EMAIL_ALLOW_IPS=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_MAX_ATTEMPTS=
EMAIL_POLL_INTERVAL_MS=
EMAIL_PORT=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# SIGNER / GEMMA
# ---------------------------------------------------------------------------
SIGNER_PASSWORD=
GEMMA_MODEL=
GEMMA_URL=

# ---------------------------------------------------------------------------
# SMTP (transactional email via SMTP_HOST/SMTP_PORT)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
