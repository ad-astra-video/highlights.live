# highlights.live — docker-compose deployment env template
# ============================================================
# Copy to `.env` (repo root, next to this file) and fill in real values, then:
#   git pull origin master
#   docker compose -f docker/docker-compose.yml up -d --force-recreate orchestrator media
#
# Docker Compose auto-loads `.env` from the project directory and substitutes the
# ${VAR:-default} references in docker/docker-compose.yml. NEVER commit a real
# `.env` (it holds secrets). This file is the durable documentation of every
# variable the compose stack reads — especially the live-payment set below,
# which is required for the paid path to work after a redeploy.

# ---------------------------------------------------------------------------
# LIVE-PAYMENT (root cause of recurring 402) — REQUIRED on the paid stack
# ---------------------------------------------------------------------------
# These MUST be present (non-empty) in .env, otherwise a redeploy resolves the
# ${SIGNER_URL:-} / ${PAYER_ADDRESS:-} placeholders to empty and every paid
# live/VOD session fails with 402 "invalid live runner payment signer address".
# See http://127.0.0.1:3000/- docs/DEPLOY.md "Live-payment durability".
#
# The remote signer's internal address (docker network DNS). The server and the
# media caller both send + validate live payments through this signer.
SIGNER_URL=http://signer:7936
# The payer EVM address advertised on reserve (public on-chain address).
PAYER_ADDRESS=
# Shared bearer token the server sends to the remote signer
# (Authorization: Bearer <token> via -remoteSignerHeaders). SECRET — keep in .env.
SIGNER_AUTH_TOKEN=
# Orchestrator ticket EV. docker-compose.yml now hard-codes -ticketEV=80000000000
# (see ADAAAA-3932) so the ORCHESTRATOR sizes live lottery batches <100 regardless;
# keep this at 80000000000 here for the signer side / documentation consistency.
TICKET_EV=80000000000

# ---------------------------------------------------------------------------
# ORCHESTRATOR (go-livepeer)
# ---------------------------------------------------------------------------
ORCHESTRATOR_SECRET=change-me
ARBITRUM_RPC=
ORCHESTRATOR_ETH_PASSWORD=change-me
PRICE_PER_UNIT=1

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=https://highlights-server.dpn.gg
PUBLIC_BASE_URL=https://highlights-server.dpn.gg
POSTGRES_USER=highlights
POSTGRES_PASSWORD=change-me
POSTGRES_DB=highlights
DECIDE_FEE=0.01
DECIDE_MODE=
MAX_PRICE_PER_UNIT=
FREE_DECIDES=5
FREE_HIGHLIGHTS=3
# Direct-dev train runner (ADAAAA-5262): when set, the server calls the train
# single-shot app directly at TRAIN_URL instead of through the orchestrator.
# Leave unset in prod (the orchestrator routes /apps/highlights-train/app/train).
TRAIN_URL=
MEDIA_SERVER_URL=http://media:4070
MEDIA_PUBLIC_BASE_URL=https://highlights-media.dpn.gg
MEDIA_PROVISION_NO_CLIENT_MS=60000
EMAIL_SENDER_URL=http://email:3001
MAILER_TOKEN=change-me
EMAIL_ALLOCATOR_BATCH_SIZE=
EMAIL_ALLOCATOR_INTERVAL_MS=
EMAIL_ALLOW_IPS=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Highlight clip trim window (ADAAAA-5059): a delivered highlight is cut to
# [event - CLIP_BEFORE_S, event + CLIP_AFTER_S]. Defaults are 2/2 = a 4s window
# centered on the flagged event ("the moment") instead of the old 8s (4/4) that
# read as the whole segment. Tunable per-deployment; a Product decision.
CLIP_BEFORE_S=2
CLIP_AFTER_S=2
# VOD source sampling rate in frames/second (ADAAAA-5059): default raised to 5
# (previously ~1) so a brief high-value moment fires a candidate; bounded above
# by VOD_SAMPLE_MAX_FPS (8) and overridable per job via the analyzeJob sampleFps.
VOD_SAMPLE_FPS_DEFAULT=5
VOD_SAMPLE_MAX_FPS=8
EMAIL_MAX_ATTEMPTS=
EMAIL_POLL_INTERVAL_MS=
EMAIL_PORT=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# SIGNER / GEMMA
# ---------------------------------------------------------------------------
SIGNER_PASSWORD=
GEMMA_MODEL=
GEMMA_URL=

# ---------------------------------------------------------------------------
# GPU PERCEIVE (DURABLE GPU-ON-LAUNCH, ADAAAA-5269)
# ---------------------------------------------------------------------------
# docker/docker-compose.yml now bakes GPU into the BASE file: perceive runs the
# prebuilt CUDA image adastravideo/highlights-live:perceive with
# PERCEIVE_DEVICE=cuda / PERCEIVE_MODE=florence / PERCEIVE_TRACKER=florence_sam
# and an NVIDIA device reservation on GPU 0; gemma + decide carry NVIDIA
# reservations on GPU 1. A plain `docker compose -f docker/docker-compose.yml
# up -d` therefore launches on GPU — it can no longer silently fall back to the
# CPU Dockerfile.perceive defaults (PERCEIVE_MODE=stub / PERCEIVE_DEVICE=cpu).
#
# HF_TOKEN: REQUIRED to download the GATED facebook/sam3.1 weights on a COLD HF
# cache (perceive will otherwise fail to boot florence_sam). A warm cache (the
# box keeps one at /home/brad/.cache/huggingface) boots without it. SECRET —
# keep in .env / docker/.env, never commit.
HF_TOKEN=
# Host path to the shared Hugging Face cache mounted at /models/hf-cache.
HF_CACHE_DIR=/home/brad/.cache/huggingface
# VOD clips dir mounted at /clips (read-only) for the SAM backend.
CLIPS_DIR=./clips
# Server dataDir mounted at /data (perceive clip root for live/VOD streams).
DATA_DIR=./data
PERCEIVE_CLIP_ROOT=/data
# Sampling budget / capacity tuning (defaults in compose).
PERCEIVE_MIN_FPS=1.0
PERCEIVE_CAPACITY=2

# ---------------------------------------------------------------------------
# SMTP (transactional email via SMTP_HOST/SMTP_PORT)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
