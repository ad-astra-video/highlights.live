# GPU fine-tune runner (highlights-train) — Florence-2 <OD> LoRA.
# base: pytorch 2.7.1 cu128 runtime (torch CUDA + triton + Python 3.12).
# This is the train-only sibling of Dockerfile.perceive.gpu: same base + the
# same training deps (transformers/peft/accelerate/safetensors) plus the
# FastAPI wrapper (fastapi/uvicorn come from services/requirements.txt), so the
# single-shot fine-tune app is served over uvicorn at /app/train
# (http://train:8083 per docker/runners.json), NOT the env-driven Livepeer
# train-entrypoint.sh that the shared perceive image uses.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

WORKDIR /srv

# py3.12: keep setuptools<81 so pkg_resources still exists (transformers chain)
RUN pip install --no-cache-dir --upgrade pip "setuptools<81"

# Florence-2 fine-tune stack + the FastAPI/uvicorn wrapper (in requirements.txt).
COPY services/requirements.txt /srv/requirements.txt
RUN pip install --no-cache-dir -r /srv/requirements.txt \
 && pip install --no-cache-dir "transformers==4.49.0" "peft" "accelerate" safetensors

# Base/pre-trained weight cache + fine-tune artifacts live outside the image
# (mounted at runtime so a warm cache + produced checkpoints survive restarts).
ENV HF_HOME=/models/hf-cache \
    TRAIN_OUT=/runs \
    TRAIN_WORK_ROOT=/runs/train-work

# Fine-tune service (fine_tune_od.py) + the FastAPI single-shot app (run.py).
COPY services/train /srv/train
WORKDIR /srv/train
EXPOSE 8083

# Single-shot train app reachable at /app/train (orchestrator proxy -> train:8083).
ENTRYPOINT ["uvicorn", "run:app", "--host", "0.0.0.0", "--port", "8083"]
