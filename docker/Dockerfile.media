FROM node:24-slim
# ADAAAA-7689 AC4: the shipped revision, published on the media node's `/health`
# as `buildRef`. Defaults to "unknown" rather than guessing; the compose service
# passes BUILD_REF from the deploy (`BUILD_REF=$(git rev-parse --short HEAD)`).
ARG BUILD_REF=unknown
ENV BUILD_REF=${BUILD_REF}
# ffmpeg decodes the WebRTC-ingested H264/VP8/VP9 stream to sampled JPEGs
# on the media server (C1 — browser WebRTC -> media server -> video-in rail).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Whole monorepo; .dockerignore strips .venv/node_modules/data.
COPY . .
RUN npm ci
ENV NODE_ENV=production
EXPOSE 4070
# ADAAAA-7750: run the service as PID 1 instead of behind `npx`. With npm as PID 1
# a container restart (docker restart, compose recreate) delivered SIGTERM to npm,
# which killed the tsx child before the media process's `SIGTERM` handler could
# write its exit to the lifecycle ledger - so the next boot recorded the previous
# boot as `unobserved-exit` and `/health` reported `restartCause: "crash"` for a
# deploy. That mislabel is what made the 05:47Z recreate read as a 23-minute
# crash outage (ADAAAA-7750 AC1). Node as PID 1 receives the signal itself and
# records `{code:0, signal:"SIGTERM", reason:"signal"}` (verified locally), which
# the ledger reports as `restartCause: "restart"`.
CMD ["node", "--import", "tsx", "services/media/src/index.ts"]
