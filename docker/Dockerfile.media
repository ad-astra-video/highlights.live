FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Whole monorepo; .dockerignore strips .venv/node_modules/data.
COPY . .
RUN npm ci
ENV NODE_ENV=production
EXPOSE 4070
CMD ["npx", "tsx", "services/media/src/index.ts"]
