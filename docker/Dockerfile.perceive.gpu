# GPU perceive runner with SAM 3.1 (triton/CUDA), for Blackwell+ Ampere GPUs.
# base: pytorch 2.7.1 cu128 runtime (torch CUDA + triton + Python 3.12).
# SAM 3.1 needs: Python 3.12+, triton (CUDA), gated facebook/sam3.1 weights.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

WORKDIR /srv

# py3.12: keep setuptools<81 so pkg_resources still exists (SAM 3 imports it)
RUN pip install --no-cache-dir --upgrade pip "setuptools<81" "einops"

# perceive service deps + Florence-2 runtime on torch (CUDA) + openvino fallback
COPY services/requirements.txt /srv/requirements.txt
RUN pip install --no-cache-dir -r /srv/requirements.txt \
 && pip install --no-cache-dir "transformers==4.49.0" timm openvino

# SAM 3 SDK, vendored at the build context root (sam3/). -e install pulls its
# core deps (timm/ftfy/regex/iopath/huggingface_hub); einops + pycocotools are
# required by its runtime import chain (sam3.train.data) but not listed in core.
COPY sam3 /srv/sam3
RUN pip install --no-cache-dir -e /srv/sam3 \
 && pip install --no-cache-dir pycocotools

# gated weight cache lives outside the image (mounted at runtime)
ENV HF_HOME=/models/hf-cache

# perceive app + entrypoint
COPY services/perceive /srv/perceive
COPY docker/perceive-entrypoint.sh /srv/perceive-entrypoint.sh
RUN chmod +x /srv/perceive-entrypoint.sh
WORKDIR /srv/perceive
EXPOSE 8080

ENV PERCEIVE_CAPACITY=2 \
    PERCEIVE_MODE=florence \
    PERCEIVE_DEVICE=cuda \
    PERCEIVE_TRACKER=florence_sam \
    PERCEIVE_MIN_FPS=1.0

ENTRYPOINT ["/srv/perceive-entrypoint.sh"]
